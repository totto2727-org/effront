{
  "name": "@effront/alchemy",
  "version": "0.1.3",
  "description": "Native Alchemy Cloudflare integration for Effront applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/effront.git",
    "directory": "packages/alchemy"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/vite": {
      "types": "./dist/cloudflare/vite.d.ts",
      "default": "./dist/cloudflare/vite.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effront/core": "workspace:*",
    "@effront/vite": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@effront/core": "workspace:^",
    "@effront/vite": "workspace:^",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "vite": "*"
  }
}
