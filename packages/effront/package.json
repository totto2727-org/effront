{
  "name": "effront",
  "version": "0.1.0",
  "description": "Effect-native React Server Components with a portable Web Fetch runtime.",
  "keywords": [
    "cloudflare-workers",
    "effect",
    "react-server-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/effront.git",
    "directory": "packages/effront"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "default": "./dist/unsupported.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "default": "./dist/workers.js"
    },
    "./internal/client-entry": {
      "types": "./dist/client/entry.d.ts",
      "default": "./dist/client/entry.js"
    },
    "./internal/ssr-entry": {
      "types": "./dist/server/ssr.d.ts",
      "default": "./dist/server/ssr.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
