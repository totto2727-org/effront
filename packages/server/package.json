{
  "name": "@effront/server",
  "version": "0.1.4",
  "description": "Native Effect HTTP hosting and Vite integration for Effront on Node.js and Bun.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/effront.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effront/core": "workspace:*",
    "@effront/vite": "workspace:*",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effront/core": "workspace:^",
    "@effront/vite": "workspace:^",
    "effect": "catalog:",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "@effront/vite": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
